From 0000000000000000000000000000000000000004 Mon Sep 17 00:00:00 2001
Subject: [PATCH 4/4] kconfig: Support help option in menu statement

Allow 'help' in 'menu' blocks, e.g.

  menu "Foo"
  	help
  	  Help text for Foo.

The help text is attached to the menu entry and shown by menuconfig
( '?' key ) and nconfig ( F2 / '?' key ) like config option help.

Also:
* Merge menu visibility_list/depends_list into menu_option_list.
* Guard NULL symbol deref in help warnings and menu_get_ext_help(),
  since menu entries have no symbol.
* Regenerate zconf.tab.c_shipped with: bison -l -t -b zconf zconf.y
  (conflict count changes from 32 to 31, %expect updated).
---
diff --git a/mconf.c b/mconf.c
index 5924006..bc6fcf2 100644
--- a/mconf.c
+++ b/mconf.c
@@ -741,7 +741,7 @@ static void conf(struct menu *menu, struct menu *active_menu)
 			}
 			break;
 		case 2:
-			if (sym)
+			if (sym || (submenu && menu_has_help(submenu)))
 				show_help(submenu);
 			else {
 				reset_subtitle();
diff --git a/menu.c b/menu.c
index 0d9951d..6814294 100644
--- a/menu.c
+++ b/menu.c
@@ -869,7 +869,7 @@ void menu_get_ext_help(struct menu *menu, struct gstr *help)
 	const char *help_text = nohelp_text;
 
 	if (menu_has_help(menu)) {
-		if (sym->name)
+		if (sym && sym->name)
 			str_printf(help, "%s%s:\n\n", CONFIG_, sym->name);
 		help_text = menu_get_help(menu);
 	}
