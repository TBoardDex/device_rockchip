#!/bin/sh
# SPDX-License-Identifier: MIT

DAEMON=/usr/bin/lvglsim
PIDFILE=/run/lvgl-demo.pid
LOGFILE=/var/log/lvgl-demo.log
DRM_DEVICE=/dev/dri/card0

start_demo()
{
	if start-stop-daemon --stop --test --quiet --pidfile "$PIDFILE" \
		--exec "$DAEMON"; then
		echo "LVGL demo is already running"
		return 0
	fi

	for timeout in $(seq 1 50); do
		[ -e "$DRM_DEVICE" ] && break
		sleep 0.1
	done

	if [ ! -e "$DRM_DEVICE" ]; then
		echo "LVGL demo: $DRM_DEVICE is not available" >&2
		return 1
	fi

	echo "Starting LVGL demo"
	start-stop-daemon --start --quiet --background --make-pidfile \
		--pidfile "$PIDFILE" --exec "$DAEMON" --output "$LOGFILE"
}

stop_demo()
{
	echo "Stopping LVGL demo"
	start-stop-daemon --stop --quiet --oknodo \
		--pidfile "$PIDFILE" --exec "$DAEMON"
	rm -f "$PIDFILE"
}

case "$1" in
	start)
		start_demo
		;;
	stop)
		stop_demo
		;;
	restart|force-reload)
		stop_demo
		start_demo
		;;
	status)
		if start-stop-daemon --stop --test --quiet --pidfile "$PIDFILE" \
			--exec "$DAEMON"; then
			echo "LVGL demo is running"
		else
			echo "LVGL demo is not running"
			exit 3
		fi
		;;
	*)
		echo "Usage: $0 {start|stop|restart|force-reload|status}" >&2
		exit 1
		;;
esac

exit $?
